# ---------------------------------------------------------------------------
# CornerOps One — environment variables (copy to .env.local for development)
# Never commit real values. Server-only unless prefixed NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Runtime
APP_MODE=demo                 # demo | production  (production disables the Demo Workspace and simulator)
APP_ENV=development           # development | test | staging | production

# Database (server-only). Local: npm run db:local:start
# Hosted Supabase: use the pooler connection string (transaction mode, port 6543).
DATABASE_URL=postgres://postgres@127.0.0.1:54329/cornerops
DATABASE_POOL_MAX=10
# Separate small pool for system work (demo simulator, session bootstrap)
DATABASE_SYSTEM_POOL_MAX=3

# Migrations (never set on the web service). Direct or session-mode connection only —
# the transaction pooler (:6543 / pgbouncer=true) is refused. Required in staging/production;
# local development falls back to DATABASE_URL. Non-local targets also need MIGRATION_CONFIRM
# set to the latest migration version (see docs/deployment/railway.md).
# MIGRATION_DATABASE_URL=
# MIGRATION_CONFIRM=

# Authentication
AUTH_PROVIDER=local           # supabase | local  (local is a development stand-in; refused in staging/production)
SESSION_SECRET=               # local provider only — 32+ random chars: openssl rand -base64 48

# Supabase Auth (AUTH_PROVIDER=supabase). Publishable key only — never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Demo Workspace (APP_MODE=demo)
DEMO_USER_EMAIL=demo@cornerops.one
DEMO_USER_PASSWORD=           # required with AUTH_PROVIDER=supabase (pre-provisioned demo user)
DEMO_AUTO_REFRESH=daily       # daily | off — regenerate the demo once per Dubai day when entered

# Local fixtures (npm run db:seed:demo -- --fixtures). Local databases only.
LOCAL_FIXTURE_PASSWORD=
